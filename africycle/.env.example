# Copy this file to .env and fill in the values. Never commit .env.

# Signs login tokens. The app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Phone numbers allowed to register as admin, separated by commas, e.g. 699999999
ADMIN_PHONE_NUMBERS=

# Optional: a Postgres connection address (e.g. from Neon).
# Leave empty to use the local SQLite file in backend/database/.
DATABASE_URL=

# Optional, for phone notifications. Without these, the app makes its own signing key
# and keeps it in the database, and uses the site's address as its contact.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: your own OSRM routing server for road directions (see README)
# ROUTING_URL=
