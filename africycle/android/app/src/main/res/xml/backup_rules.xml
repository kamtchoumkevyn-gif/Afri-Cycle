<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6.0 to 11: nothing is backed up (allowBackup is false as well). Android 12 and
     newer read data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
